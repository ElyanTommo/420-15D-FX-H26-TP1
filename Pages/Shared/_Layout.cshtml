<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - _420_15D_FX_H26_TP1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_420_15D_FX_H26_TP1.styles.css" asp-append-version="true" />
</head>
<body>
  
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-gradient bg-secondary shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <i class="bi bi-calendar-event me-2"></i>
                    Flash
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i> Accueil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-page="/Evenements/Index">
                                <i class="bi bi-calendar3 me-1"></i> Évènements
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-page="/Evenements/MesEvenemnts">
                                    <i class="bi bi-person-circle me-1"></i> Mes Évènements
                                </a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="Admin" asp-page="/Categories/Index">
                                    <i class="bi bi-gear me-1"></i> Catégories
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - _420_15D_FX_H26_TP1 - 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
