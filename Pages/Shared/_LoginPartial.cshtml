@using Microsoft.AspNetCore.Identity
@using _420_15D_FX_H26_TP1.Models
@inject SignInManager<Utilisateur> SignInManager
@inject UserManager<Utilisateur> UserManager

<ul class="navbar-nav align-items-center">

    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item me-3">
            <a class="nav-link d-flex align-items-center text-white"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Gérer le compte">
                <i class="bi bi-person-circle me-2 fs-5"></i>
                <span class="fw-semibold">Bonjour @User.Identity?.Name!</span>
            </a>
        </li>

        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">

                <button type="submit"
                        class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Déconnexion
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item me-2">
            <a class="btn btn-outline-light btn-sm"
               asp-area="Identity"
               asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>
                Connexion
            </a>
        </li>

        <li class="nav-item">
            <a class="btn btn-light btn-sm fw-semibold"
               asp-area="Identity"
               asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i>
                Inscription
            </a>
        </li>
    }

</ul>

