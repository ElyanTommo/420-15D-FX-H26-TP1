@page
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 text-center p-5" style="max-width: 600px; width:100%;">

        <div class="mb-4">
            <i class="bi bi-calendar-event display-3 text-primary"></i>
        </div>

        <h1 class="display-5 fw-bold mb-3">Bienvenue</h1>

        <p class="lead text-muted mb-4">
            @Model.Description
        </p>

        <div class="d-grid gap-2">
            <a asp-page="/Evenements/Index"
               class="btn btn-primary btn-lg">
                <i class="bi bi-eye me-2"></i>
                Voir nos évènements
            </a>
        </div>

    </div>
</div>


