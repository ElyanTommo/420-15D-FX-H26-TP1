@page
@model _420_15D_FX_H26_TP1.Pages.Evenements.CreateModel

        @{
        ViewData["Title"] = "Create";
        }

<h1 class="text-center my-4">Créer votre évènement</h1>
    <div class="row">
    <div class="col-md-4">
    
        <form method="post" enctype="multipart/form-data" class="mt-4">
            <input type="hidden" asp-for="Evenement.OrganisateurId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="mb-4 fw-bold">Créer un événement</h4>

                    <div class="mb-3">
                        <label asp-for="Evenement.Titre" class="form-label fw-semibold"></label>
                        <input asp-for="Evenement.Titre" class="form-control" placeholder="Ex : Soirée jeux, Conférence, Tournoi..." />
                        <span asp-validation-for="Evenement.Titre" class="text-danger small"></span>
                    </div>

                    
                    <div class="mb-3">
                        <label asp-for="Evenement.Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Evenement.Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Décris ton événement en quelques lignes..."></textarea>
                        <span asp-validation-for="Evenement.Description" class="text-danger small"></span>
                    </div>

                    
                    <div class="mb-3">
                        <label asp-for="Evenement.CategorieId" class="form-label fw-semibold">Categories</label>
                        <select asp-for="Evenement.CategorieId"
                                class="form-select"
                                asp-items="ViewBag.CategorieId">
                            <option value="">-- Choisir une catégorie --</option>
                        </select>
                        <span asp-validation-for="Evenement.CategorieId" class="text-danger small"></span>
                    </div>

                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Evenement.Ville" class="form-label fw-semibold"></label>
                            <input asp-for="Evenement.Ville" class="form-control" placeholder="Ex : Montréal" />
                            <span asp-validation-for="Evenement.Ville" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Evenement.CodePostal" class="form-label fw-semibold"></label>
                            <input asp-for="Evenement.CodePostal" class="form-control" placeholder="Ex : H2X 1Y4" />
                            <span asp-validation-for="Evenement.CodePostal" class="text-danger small"></span>
                        </div>

                       
                    </div>
                    <div class="col-md-8 mb-3">
                        <label asp-for="Evenement.Adresse" class="form-label fw-semibold"></label>
                        <input asp-for="Evenement.Adresse" class="form-control" placeholder="Ex : 123 rue Sainte-Catherine" />
                        <span asp-validation-for="Evenement.Adresse" class="text-danger small"></span>
                    </div>
                   
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Evenement.DateDebut" class="form-label fw-semibold"></label>
                            <input asp-for="Evenement.DateDebut" type="date" class="form-control" />
                            <span asp-validation-for="Evenement.DateDebut" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Evenement.DateFin" class="form-label fw-semibold"></label>
                            <input asp-for="Evenement.DateFin" type="date" class="form-control" />
                            <span asp-validation-for="Evenement.DateFin" class="text-danger small"></span>
                        </div>
                    </div>

                    
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Image (optionnel)</label>
                        <input type="file"
                               name="ImageFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">
                            Formats acceptés : JPG, PNG, WEBP
                        </div>
                    </div>

                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            Créer
                        </button>

                        <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                            Annuler
                        </a>
                    </div>

                </div>
            </div>
        </form>

</div>

<div>
    <a class="btn btn-secondary" asp-page="Index">Retour à l'accueil' </a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
