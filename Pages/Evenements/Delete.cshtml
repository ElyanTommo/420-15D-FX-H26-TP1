@page
@model _420_15D_FX_H26_TP1.Pages.Evenements.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

@* <h1>Supprimer évènement</h1>

<h3>Are you sure you want to delete this?</h3> *@
<div class="text-center mb-4">
    <h1 class="display-5 fw-bold text-warning">
        <i class="bi bi-archive"></i> Supprimer l'événement
    </h1>
    <p class="text-muted">
        L'événement sera supprimer définitivement.
    </p>
</div>

<!-- Message d'avertissement -->
<div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
    <div>
        <strong>Attention!</strong> Cette action va supprimer l'événement.
       @*  Il restera accessible dans la section
        <strong>"Événements archivés"</strong>. *@
    </div>
</div>
<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Titre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Titre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Organisateur)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Organisateur.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Categorie)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Categorie.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Ville)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Ville)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Adresse)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Adresse)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.DateDebut)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.DateDebut)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.DateFin)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.DateFin)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Image)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Image)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Evenement.Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-page="./Index">Retour à la liste</a>
    </form>
</div>
