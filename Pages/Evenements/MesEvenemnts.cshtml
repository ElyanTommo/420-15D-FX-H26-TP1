
@page
@model _420_15D_FX_H26_TP1.Pages.Evenements.MesEvenemntsModel

@{
    ViewData["Title"] = "Mes événements";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-person-circle text-primary"></i> Mes Événements
        </h1>
        <p class="lead text-muted">
            Bienvenue, <strong>@Model.NomUtilisateur</strong>
        </p>
    </div>

    <div class="d-flex gap-2 mb-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Tous les événements
        </a>
        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Créer un événement
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

   
    <div class="mb-5">
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-calendar-plus text-success me-2 fs-3"></i>
            <h2 class="mb-0">Événements organisés</h2>
            <span class="badge bg-success ms-3 fs-6">@Model.EvenementsOrganises.Count</span>
        </div>

        @if (!Model.EvenementsOrganises.Any())
        {
            <div class="alert alert-light border">
                <i class="bi bi-info-circle text-muted"></i>
                Vous n'avez créé aucun événement actif.
                <a asp-page="./Create" class="alert-link">Créer mon premier événement</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var eve in Model.EvenementsOrganises)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 hover-card">
                            <div class="position-relative overflow-hidden">
                                @if (!string.IsNullOrEmpty(eve.Image))
                                {
                                    <img src="@Model.ImagePath@eve.Image"
                                         class="card-img-top"
                                         alt="@eve.Titre"
                                         style="height: 180px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="card-img-top d-flex align-items-center justify-content-center"
                                         style="height: 180px; background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
                                        <i class="bi bi-calendar-event text-white" style="font-size: 3rem; opacity: 0.7;"></i>
                                    </div>
                                }

                                <span class="position-absolute top-0 start-0 m-2 badge bg-success">
                                    <i class="bi bi-star-fill"></i> Organisateur
                                </span>

                                @if (eve.Categorie != null)
                                {
                                    <span class="position-absolute top-0 end-0 m-2 badge bg-primary">
                                        @eve.Categorie.Nom
                                    </span>
                                }
                            </div>

                            <div class="card-body">
                                <h5 class="card-title fw-bold">@eve.Titre</h5>
                                <p class="card-text text-muted small">
                                    @(eve.Description.Length > 80 ? eve.Description.Substring(0, 80) + "..." : eve.Description)
                                </p>

                                <div class="mb-2">
                                    <small>
                                        <i class="bi bi-calendar-event text-primary"></i>
                                        @eve.DateDebut.ToString("dd/MM/yyyy")
                                    </small>
                                </div>

                                <div class="mb-2">
                                    <span class="badge bg-info">
                                        <i class="bi bi-people-fill"></i> @eve.Participations.Count participant(s)
                                    </span>
                                </div>
                            </div>

                            <div class="card-footer bg-white">
                                <div class="d-grid gap-2">
                                    <a asp-page="./Details" asp-route-id="@eve.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Détails
                                    </a>
                                    <div class="btn-group">
                                        <a asp-page="./Edit" asp-route-id="@eve.Id" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@eve.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-archive"></i> Archiver
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <hr class="my-5">

   
    <div class="mb-5">
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-ticket-perforated text-primary me-2 fs-3"></i>
            <h2 class="mb-0">Mes Participations</h2>
            <span class="badge bg-primary ms-3 fs-6">@Model.MesParticipations.Count</span>
        </div>

        @if (!Model.MesParticipations.Any())
        {
            <div class="alert alert-light border">
                <i class="bi bi-info-circle text-muted"></i>
                Vous n'êtes inscrit à aucun événement.
                <a asp-page="./Index" class="alert-link">Découvrir les événements</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var participation in Model.MesParticipations)
                {
                    var eve = participation.Evenement;
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 hover-card">
                            <div class="position-relative overflow-hidden">
                                @if (!string.IsNullOrEmpty(eve.Image))
                                {
                                    <img src="@Model.ImagePath@eve.Image"
                                         class="card-img-top"
                                         alt="@eve.Titre"
                                         style="height: 180px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="card-img-top d-flex align-items-center justify-content-center"
                                         style="height: 180px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <i class="bi bi-calendar-event text-white" style="font-size: 3rem; opacity: 0.7;"></i>
                                    </div>
                                }

                                <span class="position-absolute top-0 start-0 m-2 badge bg-info">
                                    <i class="bi bi-check-circle-fill"></i> Inscrit
                                </span>

                                @if (eve.Categorie != null)
                                {
                                    <span class="position-absolute top-0 end-0 m-2 badge bg-primary">
                                        @eve.Categorie.Nom
                                    </span>
                                }
                            </div>

                            <div class="card-body">
                                <h5 class="card-title fw-bold">@eve.Titre</h5>
                                <p class="card-text text-muted small">
                                    @(eve.Description.Length > 80 ? eve.Description.Substring(0, 80) + "..." : eve.Description)
                                </p>

                                <div class="mb-2">
                                    <small>
                                        <i class="bi bi-calendar-event text-primary"></i>
                                        @eve.DateDebut.ToString("dd/MM/yyyy")
                                    </small>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-person-circle text-success"></i>
                                        Organisé par @eve.Organisateur?.Prenom @eve.Organisateur?.Nom
                                    </small>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i>
                                        Inscrit le @participation.DateInscription.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>

                            <div class="card-footer bg-white">
                                <a asp-page="./Details" asp-route-id="@eve.Id" class="btn btn-sm btn-primary w-100">
                                    <i class="bi bi-eye"></i> Voir les détails
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <hr class="my-5">

 
    <div class="mb-5">
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-archive text-secondary me-2 fs-3"></i>
            <h2 class="mb-0">Mes évènements supprimés</h2>
            <span class="badge bg-secondary ms-3 fs-6">@Model.EvenementsArchives.Count</span>
        </div>

        @if (!Model.EvenementsArchives.Any())
        {
            <div class="alert alert-light border">
                <i class="bi bi-info-circle text-muted"></i>
                Aucun événement archivé.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var eve in Model.EvenementsArchives)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 opacity-75">
                            <div class="position-relative overflow-hidden">
                                @if (!string.IsNullOrEmpty(eve.Image))
                                {
                                    <img src="@Model.ImagePath@eve.Image"
                                         class="card-img-top"
                                         alt="@eve.Titre"
                                         style="height: 180px; object-fit: cover; filter: grayscale(50%);" />
                                }
                                else
                                {
                                    <div class="card-img-top d-flex align-items-center justify-content-center"
                                         style="height: 180px; background: linear-gradient(135deg, #999 0%, #666 100%);">
                                        <i class="bi bi-calendar-event text-white" style="font-size: 3rem; opacity: 0.7;"></i>
                                    </div>
                                }

                                <span class="position-absolute top-0 start-0 m-2 badge bg-secondary">
                                    <i class="bi bi-archive"></i> Archivé
                                </span>

                                @if (eve.Categorie != null)
                                {
                                    <span class="position-absolute top-0 end-0 m-2 badge bg-dark">
                                        @eve.Categorie.Nom
                                    </span>
                                }
                            </div>

                            <div class="card-body">
                                <h5 class="card-title fw-bold">@eve.Titre</h5>
                                <p class="card-text text-muted small">
                                    @(eve.Description.Length > 80 ? eve.Description.Substring(0, 80) + "..." : eve.Description)
                                </p>

                                <div class="mb-2">
                                    <small><i class="bi bi-calendar-event text-muted"></i> @eve.DateDebut.ToString("dd/MM/yyyy")</small>
                                </div>

                                <div class="mb-2">
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-people-fill"></i> @eve.Participations.Count participant(s)
                                    </span>
                                </div>
                            </div>

                            <div class="card-footer bg-white">
                                <a asp-page="./Details" asp-route-id="@eve.Id" class="btn btn-sm btn-outline-secondary w-100">
                                    <i class="bi bi-eye"></i> Voir les détails
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <hr class="my-5">

 
   