<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons (optionnel mais recommandé) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_420_15D_FX_H26_TP1.styles.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
            <div class="container">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-area="Admin" asp-page="/Index">
                    <i class="bi bi-speedometer2"></i>
                    Admin
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarAdmin"
                        aria-controls="navbarAdmin"
                        aria-expanded="false"
                        aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarAdmin">
                    <ul class="navbar-nav ms-auto gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="Admin" asp-page="/Evenements/Index">
                                <i class="bi bi-calendar-event me-1"></i>
                                Évènements
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="Admin" asp-page="/Categories/Index">
                                <i class="bi bi-tags me-1"></i>
                                Catégories
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i>
                                Retour site
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- CONTENU -->
    <div class="container py-4">

        <!-- Carte globale pour rendre le rendu plus clean -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <footer class="py-4 mt-auto">
        <div class="container">
            <div class="text-center text-muted small">
                <span class="fw-semibold">Admin</span> •
                &copy; 2026 - _420_15D_FX_H26_TP1
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
