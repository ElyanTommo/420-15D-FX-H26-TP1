@page
@model _420_15D_FX_H26_TP1.Areas.Admin.Pages.Categories.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Supprimer catégorie</h1>

<h3>Etes-vous sure de vouloir cette catégorie?</h3>
<div>
    @if (!string.IsNullOrEmpty(Model.ErreurMessage))
    {
        <div class="alert alert-danger">
            @Model.ErreurMessage
        </div>
    }
    <hr />
  
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Categorie.Nom)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Categorie.Nom)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Categorie.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a class="btn btn-secondary" asp-page="./Index">Retour à la liste des catégories</a>
      
    </form>
</div>




