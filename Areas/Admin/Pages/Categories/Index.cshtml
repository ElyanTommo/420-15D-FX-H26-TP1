
@page
@model _420_15D_FX_H26_TP1.Areas.Admin.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Catégories";
}
@if (TempData["SuccessMessageCatégorie"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessageCatégorie"]
    </div>
}
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0">Catégories</h1>
            <p class="text-muted mb-0">Gestion des catégories disponibles</p>
        </div>

        <a asp-page="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Créer une catégorie
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (Model.Categorie == null || !Model.Categorie.Any())
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    Aucune catégorie disponible pour le moment.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 70%">
                                    Nom
                                </th>
                                <th class="text-end" style="width: 30%">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Categorie)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-2">
                                            <i class="bi bi-tag"></i>
                                        </span>
                                        @item.Nom
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-page="./Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-eye me-1"></i> Détails
                                            </a>

                                            <a asp-page="./Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i> Modifier
                                            </a>

                                            <a asp-page="./Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i> Supprimer
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
