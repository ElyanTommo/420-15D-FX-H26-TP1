@page
@model _420_15D_FX_H26_TP1.Areas.Admin.Pages.Evenements.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].Titre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].Organisateur)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].Categorie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].Ville)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].Adresse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].DateDebut)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].DateFin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Evenement[0].Image)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Evenement) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Titre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Organisateur.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Categorie.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ville)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Adresse)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateDebut)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateFin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Image)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
